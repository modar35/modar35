<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:orientation="vertical" android:background="@color/bg" android:layout_width="match_parent" android:layout_height="match_parent">
    <ScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:fillViewport="true">
      <FrameLayout android:layout_width="match_parent" android:layout_height="wrap_content">
        <LinearLayout android:id="@+id/orders_content" android:orientation="vertical" android:padding="20dp" android:layout_width="match_parent" android:layout_height="wrap_content">
          <LinearLayout android:gravity="center_vertical" android:layout_width="match_parent" android:layout_height="wrap_content">
            <LinearLayout android:orientation="vertical" android:layout_weight="1" android:layout_width="0dp" android:layout_height="wrap_content">
              <TextView android:text="Грузовичок" android:textColor="@color/text" android:textSize="28sp" android:fontFamily="sans-serif-medium" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
              <TextView android:text="Доставка грузов по городу и области" android:textColor="@color/text_muted" android:textSize="14sp" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="3dp"/>
            </LinearLayout>
            <TextView android:text="⌖  Москва" android:textColor="@color/accent" android:textSize="14sp" android:padding="10dp" android:background="@drawable/chip_bg" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
          </LinearLayout>
          <LinearLayout android:gravity="center_vertical" android:layout_marginTop="22dp" android:layout_width="match_parent" android:layout_height="wrap_content">
            <TextView android:text="Заказы рядом" android:textColor="@color/text" android:textSize="20sp" android:fontFamily="sans-serif-medium" android:layout_weight="1" android:layout_width="0dp" android:layout_height="wrap_content"/>
            <TextView android:id="@+id/btn_filter" android:text="☷  Фильтр" android:textColor="@color/accent" android:textSize="14sp" android:padding="10dp" android:clickable="true" android:background="@drawable/chip_bg" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
          </LinearLayout>
          <TextView android:text="Свежие заявки от клиентов" android:textColor="@color/text_muted" android:textSize="13sp" android:layout_marginTop="4dp" android:layout_width="wrap_content" android:layout_height="wrap_content"/>

          <include layout="@layout/item_cargo_1"/>
          <include layout="@layout/item_cargo_2"/>
          <include layout="@layout/item_cargo_3"/>
          <LinearLayout android:id="@+id/order_list" android:orientation="vertical" android:layout_width="match_parent" android:layout_height="wrap_content"/>
          <TextView android:id="@+id/btn_create" android:text="＋  Создать заявку на перевозку" android:gravity="center" android:textColor="@color/white" android:textSize="16sp" android:fontFamily="sans-serif-medium" android:background="@drawable/btn_primary" android:layout_marginTop="18dp" android:layout_width="match_parent" android:layout_height="54dp"/>
        </LinearLayout>
        <LinearLayout android:id="@+id/trips_content" android:visibility="gone" android:orientation="vertical" android:padding="20dp" android:layout_width="match_parent" android:layout_height="wrap_content">
          <TextView android:text="Мои рейсы" android:textColor="@color/text" android:textSize="28sp" android:fontFamily="sans-serif-medium" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
          <TextView android:text="Здесь появятся принятые заказы и история доставок" android:textColor="@color/text_muted" android:textSize="15sp" android:layout_marginTop="8dp" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
          <TextView android:id="@+id/trips_status" android:text="✓  Сегодня · 0 активных рейсов" android:textColor="@color/text" android:textSize="16sp" android:background="@drawable/card_bg" android:padding="20dp" android:layout_marginTop="28dp" android:layout_width="match_parent" android:layout_height="wrap_content"/>
          <TextView android:id="@+id/btn_start_trip" android:text="Начать рейс" android:gravity="center" android:textColor="@color/white" android:textSize="16sp" android:background="@drawable/btn_primary" android:layout_marginTop="16dp" android:layout_width="match_parent" android:layout_height="52dp"/>
          <TextView android:id="@+id/btn_finish_trip" android:text="Завершить доставку" android:gravity="center" android:textColor="@color/accent" android:textSize="16sp" android:background="@drawable/btn_secondary" android:layout_marginTop="10dp" android:layout_width="match_parent" android:layout_height="52dp"/>
          <TextView android:id="@+id/btn_add_trip" android:text="Найти ещё заказ" android:gravity="center" android:textColor="@color/text_muted" android:textSize="15sp" android:padding="16dp" android:layout_marginTop="4dp" android:layout_width="match_parent" android:layout_height="wrap_content"/>
        </LinearLayout>
        <LinearLayout android:id="@+id/profile_content" android:visibility="gone" android:orientation="vertical" android:padding="20dp" android:layout_width="match_parent" android:layout_height="wrap_content">
          <TextView android:text="Профиль" android:textColor="@color/text" android:textSize="28sp" android:fontFamily="sans-serif-medium" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
          <TextView android:id="@+id/profile_subtitle" android:text="Водитель не авторизован" android:textColor="@color/text_muted" android:textSize="15sp" android:layout_marginTop="8dp" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
          <TextView android:id="@+id/profile_card" android:text="🚚  Добавить автомобиль\n\nУкажите марку, тип кузова и грузоподъёмность, чтобы получать подходящие заявки." android:textColor="@color/text" android:textSize="16sp" android:background="@drawable/card_bg" android:padding="20dp" android:layout_marginTop="28dp" android:layout_width="match_parent" android:layout_height="wrap_content"/>
          <TextView android:id="@+id/btn_login" android:text="Войти по номеру телефона" android:gravity="center" android:textColor="@color/white" android:textSize="16sp" android:background="@drawable/btn_primary" android:layout_marginTop="16dp" android:layout_width="match_parent" android:layout_height="52dp"/>
          <TextView android:id="@+id/btn_verify" android:text="Пройти верификацию водителя" android:visibility="gone" android:gravity="center" android:textColor="@color/white" android:textSize="16sp" android:background="@drawable/btn_primary" android:layout_marginTop="16dp" android:layout_width="match_parent" android:layout_height="52dp"/>
          <TextView android:id="@+id/btn_logout" android:text="Выйти из аккаунта" android:visibility="gone" android:gravity="center" android:textColor="@color/danger" android:textSize="15sp" android:padding="16dp" android:layout_marginTop="8dp" android:layout_width="match_parent" android:layout_height="wrap_content"/>
          <TextView android:id="@+id/btn_support" android:text="Связаться с поддержкой" android:gravity="center" android:textColor="@color/accent" android:textSize="15sp" android:padding="16dp" android:layout_marginTop="12dp" android:layout_width="match_parent" android:layout_height="wrap_content"/>
        </LinearLayout>
      </FrameLayout>
    </ScrollView>
    <LinearLayout android:background="@color/surface" android:gravity="center" android:paddingTop="8dp" android:paddingBottom="8dp" android:orientation="horizontal" android:layout_width="match_parent" android:layout_height="68dp">
      <TextView android:id="@+id/tab_orders" android:text="⌂\nЗаказы" android:gravity="center" android:textColor="@color/text" android:textSize="13sp" android:layout_weight="1" android:layout_width="0dp" android:layout_height="match_parent"/>
      <TextView android:id="@+id/tab_trips" android:text="▣\nМои рейсы" android:gravity="center" android:textColor="@color/text_muted" android:textSize="13sp" android:layout_weight="1" android:layout_width="0dp" android:layout_height="match_parent"/>
      <TextView android:id="@+id/tab_profile" android:text="♙\nПрофиль" android:gravity="center" android:textColor="@color/text_muted" android:textSize="13sp" android:layout_weight="1" android:layout_width="0dp" android:layout_height="match_parent"/>
    </LinearLayout>
</LinearLayout>
